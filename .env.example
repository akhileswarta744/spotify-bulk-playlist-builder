# Spotify Developer Credentials
# Obtain your Client ID from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Spotify Redirect URI
# IMPORTANT: In modern Spotify Developer accounts (2025/2026), loopback 127.0.0.1 is required instead of localhost
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# (Optional) Client Secret - in PKCE flow this is optional for public SPA clients, but supported if set
SPOTIFY_CLIENT_SECRET=

# Server Configuration
PORT=3001
CLIENT_URL=http://127.0.0.1:5173

# Optional: Gemini API Key for smart/AI song title & context normalizer
GEMINI_API_KEY=
